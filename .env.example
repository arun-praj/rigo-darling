RIGOHR_USERNAME=your-rigohr-username
RIGOHR_PASSWORD=your-rigohr-password

RIGOHR_URL=https://app.rigohr.com/hr
PROJECT_URL=http://localhost:4317

RIGOHR_TIMEZONE=Asia/Kathmandu

RIGO_ADMIN_USERNAME=admin@example.com
RIGO_ADMIN_PASSWORD=change-this-in-your-local-env

COOKIE_SECURE=false

PORT=4317
HOST=127.0.0.1
BROWSER_HEADLESS=false
# Optional isolated browser profile for testing; the default is .browser-profile.
RIGOHR_BROWSER_PROFILE=.browser-profile
# Optional lock path preventing multiple scheduler/browser owners. The default is data/rigohr-attendance.lock.
RIGOHR_INSTANCE_LOCK=data/rigohr-attendance.lock

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

RIGOHR_DB_PATH=data/rigohr.sqlite

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-rigohr-evidence-bucket
R2_PREFIX=rigohr-attendance
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The app also accepts R2_BUCKET_NAME in place of R2_BUCKET.
